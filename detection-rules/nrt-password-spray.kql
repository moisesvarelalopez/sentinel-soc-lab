// ============================================================
// Detection Rule: NRT - Password Spray Active Attack
// Type: Near Real-Time (NRT)
// Severity: High
// MITRE Tactic: Credential Access
// MITRE Technique: T1110 - Brute Force / Password Spraying
// Data Source: Microsoft Entra ID Protection (IPC)
// Table: SecurityAlert
// ============================================================
// Description:
//   Fires within seconds of a confirmed Password Spray alert
//   from Entra ID Protection. Extracts the targeted account
//   entity from the JSON Entities field for investigation.
// ============================================================

SecurityAlert
| where AlertName == "Password Spray"
| where TimeGenerated > ago(1h)
| extend ParsedEntities = parse_json(Entities)
| mvexpand ParsedEntities
| where tostring(ParsedEntities.Type) == "account"
| extend
    TargetAccount  = tostring(ParsedEntities.Name),
    AccountDomain  = tostring(ParsedEntities.UPNSuffix),
    AccountDisplay = tostring(ParsedEntities.DisplayName)
| project
    TimeGenerated,
    AlertName,
    AlertSeverity,
    ProviderName,
    TargetAccount,
    AccountDomain,
    AccountDisplay,
    Description

// ── Entity Mapping ──────────────────────────────────────────
// Account → TargetAccount (Name)
//
// ── Alert Grouping ───────────────────────────────────────────
// Group by: Account entity
// Window:   5 hours
// Purpose:  Prevent duplicate incidents for same account
// ============================================================
